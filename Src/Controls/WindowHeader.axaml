<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
        xmlns:controls="using:Tsundoku.Controls">
	<Style Selector="controls|WindowHeader">
		<Setter Property="Template">
			<ControlTemplate>
				<Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource TsundokuDividerColor}" Padding="16,12">
					<Grid ColumnDefinitions="Auto,*,Auto">
						<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<i:Icon Value="{TemplateBinding Icon}" FontSize="16" Foreground="{DynamicResource TsundokuDividerColor}"/>
							<TextBlock Text="{TemplateBinding Title}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource TsundokuUsernameColor}" VerticalAlignment="Center"/>
						</StackPanel>
						<ContentPresenter Grid.Column="2" Content="{TemplateBinding RightContent}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>
