<!-- File: Controls/SeriesCardDisplay.axaml -->
<UserControl
    x:Class="Tsundoku.Controls.SeriesCardDisplay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:Tsundoku.Models;assembly=Tsundoku"
    xmlns:cv="clr-namespace:Tsundoku.Converters;assembly=Tsundoku"
    xmlns:i="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
    xmlns:controls="clr-namespace:Tsundoku.Controls"
    x:Name="Root"
    x:DataType="controls:SeriesCardDisplay">

  <UserControl.Styles>
    <StyleInclude Source="avares://Tsundoku/Styles/CardScrollBarStyles.axaml"/>
    <Style Selector="Image.cover-img">
      <Setter Property="RenderTransform" Value="scale(1, 1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card-hover:pointerover Image.cover-img">
      <Setter Property="RenderTransform" Value="scale(1.05, 1.05)"/>
    </Style>
    <!-- Glassmorphism: reduce solid BG opacity and show acrylic when GlassEnabled is true -->
    <Style Selector="controls|SeriesCardDisplay[GlassEnabled=True] Border#CardSolidBG">
      <Setter Property="Opacity" Value="0.3"/>
    </Style>
    <Style Selector="controls|SeriesCardDisplay[GlassEnabled=True] ExperimentalAcrylicBorder#CardAcrylicBorder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- Long descriptions fade out at the bottom until scrolled to the end, so the text doesn't look cut off -->
    <Style Selector="ScrollViewer.card-desc.fade-bottom">
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="Black"/>
          <GradientStop Offset="0.72" Color="Black"/>
          <GradientStop Offset="1" Color="Transparent"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <ResourceDictionary>
      <cv:TitleLangConverter x:Key="ConvertTitle"/>
      <cv:StaffLangConverter x:Key="ConvertStaff"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- KEY: The card tree is built once per container; a recycled card only rebinds to the new Series -->
  <Border
      Name="CardBorder"
      x:DataType="m:Series"
      DataContext="{CompiledBinding Series, ElementName=Root}"
      IsVisible="{CompiledBinding Series, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
      Margin="12"
      CornerRadius="14"
      BorderThickness="2"
      BoxShadow="0 4 13 2 #99000000"
      Width="{CompiledBinding Source={x:Static m:Constants.CARD_WIDTH}}"
      Height="{CompiledBinding Source={x:Static m:Constants.CARD_HEIGHT}}"
      UseLayoutRounding="True"
      Classes="card-hover"
      Classes.selected="{CompiledBinding IsSelected}">
    <Border.Styles>
      <Style Selector="Border.card-hover">
        <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TsundokuSeriesCardBorderColor}"/>
      </Style>
      <Style Selector="Border.card-hover.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource TsundokuSeriesProgressBarColor}"/>
      </Style>
      <Style Selector="Border.card-hover:pointerover">
        <Setter Property="RenderTransform" Value="translate(0px, -4px)"/>
      </Style>
    </Border.Styles>
    <Border.Transitions>
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>

    <Border CornerRadius="14" ClipToBounds="True" Name="CardInner">
      <Grid ColumnDefinitions="Auto,*">

        <!-- ── Hover + ToolTip Styles ── -->
        <Grid.Styles>
          <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource TsundokuStatusAndBookTypeBGColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TsundokuMenuButtonBorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TsundokuMenuButtonTextAndIconColor}"/>
          </Style>
        </Grid.Styles>

        <!-- ── Left Side: Cover ── -->
        <Panel
            Grid.Column="0"
            Width="{CompiledBinding Source={x:Static m:Constants.LEFT_SIDE_CARD_WIDTH}}"
            PointerPressed="OpenSiteLink"
            Cursor="Hand"
            Background="{DynamicResource TsundokuSeriesCoverBGColor}">

          <!-- Cover Image (full height) -->
          <Image
              Classes="cover-img"
              Height="{CompiledBinding Source={x:Static m:Constants.IMAGE_HEIGHT}}"
              Width="{CompiledBinding Source={x:Static m:Constants.LEFT_SIDE_CARD_WIDTH}}"
              Source="{CompiledBinding CoverBitMap}"
              RenderOptions.BitmapInterpolationMode="LowQuality"
              Stretch="UniformToFill"
              IsVisible="{CompiledBinding CoverBitMap, Converter={x:Static ObjectConverters.IsNotNull}}"/>

          <!-- Bulk-edit selection badge (top-left of cover) -->
          <Border IsVisible="{CompiledBinding IsSelected}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="8,8,0,0"
                  Width="26" Height="26"
                  CornerRadius="13"
                  Background="{DynamicResource TsundokuSeriesProgressBarColor}"
                  BorderBrush="{DynamicResource TsundokuMenuBGColor}"
                  BorderThickness="2"
                  BoxShadow="0 2 6 0 #99000000"
                  IsHitTestVisible="False">
              <i:Icon Value="fa7-solid fa7-check"
                      FontSize="12"
                      Foreground="{DynamicResource TsundokuMenuBGColor}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
          </Border>

          <!-- Favorite badge (top-right of cover) -->
          <Border IsVisible="{CompiledBinding Series.IsFavorite, ElementName=Root}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0"
                  Width="26" Height="26"
                  CornerRadius="13"
                  Background="{DynamicResource TsundokuMenuBGColor}"
                  BorderBrush="{DynamicResource TsundokuMenuButtonBorderColor}"
                  BorderThickness="1"
                  BoxShadow="0 2 6 0 #99000000"
                  IsHitTestVisible="False"
                  ToolTip.Tip="Favorite">
              <i:Icon Value="fa7-solid fa7-star"
                      FontSize="12"
                      Foreground="{DynamicResource TsundokuMenuButtonTextAndIconColor}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
          </Border>

          <!-- Missing Cover Fallback -->
          <StackPanel
              IsVisible="{CompiledBinding CoverBitMap, Converter={x:Static ObjectConverters.IsNull}}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Spacing="10">
            <PathIcon
                Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                Width="48" Height="48"
                Foreground="{DynamicResource TsundokuStatusAndBookTypeTextColor}"
                Opacity="0.3"/>
            <TextBlock
                TextAlignment="Center"
                MaxLines="4"
                TextTrimming="CharacterEllipsis"
                FontWeight="Bold"
                FontSize="13"
                Foreground="{DynamicResource TsundokuStatusAndBookTypeTextColor}"
                Opacity="0.5"
                Width="{CompiledBinding Source={x:Static m:Constants.LEFT_SIDE_CARD_WIDTH}}"
                Padding="8,0">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ConvertTitle}" Mode="OneWay">
                  <Binding Path="Titles"/>
                  <Binding Path="Language" ElementName="Root"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>

          <!-- Status/Format Badge Overlay (glassmorphic) -->
          <Border
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,8"
              Background="{DynamicResource TsundokuStatusAndBookTypeBGColor}"
              BorderBrush="{DynamicResource TsundokuStatusAndBookTypeBorderColor}"
              BorderThickness="2"
              CornerRadius="8"
              Padding="10,4"
              Opacity="0.92"
              BoxShadow="0 2 8 0 #40000000">
            <TextBlock
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource TsundokuStatusAndBookTypeTextColor}"
                TextAlignment="Center">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} · {1}" Mode="OneWay">
                  <Binding Path="Status"/>
                  <Binding Path="Format"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Border>
        </Panel>

        <!-- ── Right Side: Info + Progress ── -->
        <Panel Grid.Column="1" UseLayoutRounding="True">
          <!-- Solid fallback background -->
          <Border Name="CardSolidBG" Background="{DynamicResource TsundokuSeriesCardBGColor}"/>
          <!-- Glassmorphism acrylic overlay -->
          <ExperimentalAcrylicBorder
              Name="CardAcrylicBorder"
              IsVisible="False">
            <ExperimentalAcrylicBorder.Material>
              <ExperimentalAcrylicMaterial
                  BackgroundSource="Digger"
                  TintColor="#1A1A2E"
                  TintOpacity="0.75"
                  MaterialOpacity="0.6"/>
            </ExperimentalAcrylicBorder.Material>
          </ExperimentalAcrylicBorder>
          <Grid>
          <Grid RowDefinitions="*,Auto">

            <!-- Info Section -->
            <Grid
                Grid.Row="0"
                RowDefinitions="Auto,Auto,Auto,*,Auto"
                Margin="10,4,10,0">

              <!-- Publisher -->
              <TextBlock
                  Grid.Row="0"
                  Foreground="{DynamicResource TsundokuSeriesCardPublisherColor}"
                  MaxLines="1"
                  FontWeight="SemiBold"
                  FontSize="12"
                  Text="{CompiledBinding Publisher}"
                  IsHitTestVisible="False"
                  Padding="0"/>

              <!-- Series Title -->
              <TextBlock
                  Grid.Row="1"
                  x:Name="SeriesTitleTextBlock"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource TsundokuSeriesCardTitleColor}"
                  FontWeight="Bold"
                  FontSize="22"
                  PointerPressed="CopySeriesTitleAsync"
                  Cursor="Hand"
                  TextAlignment="Left"
                  TextTrimming="CharacterEllipsis"
                  MaxLines="2"
                  Padding="0,0,4,0">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ConvertTitle}" Mode="OneWay">
                    <Binding Path="Titles"/>
                    <Binding Path="Language" ElementName="Root"/>
                  </MultiBinding>
                </TextBlock.Text>
                <ToolTip.Tip>
                  <TextBlock FontWeight="Bold" TextWrapping="Wrap" FontSize="18" TextTrimming="None" MaxLines="100" LineSpacing="2">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource ConvertTitle}" Mode="OneWay">
                        <Binding Path="Titles"/>
                        <Binding Path="Language" ElementName="Root"/>
                        <Binding Path="DuplicateIndex"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </ToolTip.Tip>
              </TextBlock>

              <!-- Staff -->
              <TextBlock
                  Grid.Row="2"
                  TextWrapping="Wrap"
                  FontWeight="Bold"
                  Foreground="{DynamicResource TsundokuSeriesCardStaffColor}"
                  MaxLines="1"
                  TextTrimming="CharacterEllipsis"
                  FontSize="13"
                  Padding="0,0,4,4">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ConvertStaff}" Mode="OneWay">
                    <Binding Path="Staff"/>
                    <Binding Path="#Root.Language"/>
                  </MultiBinding>
                </TextBlock.Text>
                <ToolTip.Tip>
                  <TextBlock TextWrapping="Wrap" FontWeight="Bold" TextTrimming="None" MaxLines="100">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource ConvertStaff}" Mode="OneWay">
                        <Binding Path="Staff"/>
                        <Binding Path="#Root.Language"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </ToolTip.Tip>
              </TextBlock>

              <!-- Description -->
              <ScrollViewer
                  Name="DescriptionScroller"
                  Classes="card-desc"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="UpdateDescriptionFade"
                  Grid.Row="3">
                <TextBlock
                    TextWrapping="Wrap"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TsundokuSeriesCardDescColor}"
                    Opacity="0.9"
                    Text="{CompiledBinding Description}"
                    Padding="0,0,10,10"/>
              </ScrollViewer>

              <!-- Missing volumes (left, only when the owned run has gaps) and the volume count (right) -->
              <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,2,0,4">
                <TextBlock
                    IsVisible="{CompiledBinding HasGaps}"
                    FontSize="13"
                    FontWeight="Bold"
                    VerticalAlignment="Bottom"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    Margin="0,0,8,0">
                  <Run Text="{CompiledBinding GapMainText}" Foreground="{DynamicResource TsundokuSeriesProgressBarColor}"/>
                  <Run Text="{CompiledBinding GapSpecialText}" Foreground="{DynamicResource TsundokuSeriesSpecialVolumeColor}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <TextBlock
                      Text="{CompiledBinding MainCountText}"
                      FontSize="13"
                      FontWeight="ExtraBold"
                      Foreground="{DynamicResource TsundokuSeriesCardDescColor}"/>
                  <TextBlock
                      Text="{CompiledBinding BeyondMainText}"
                      IsVisible="{CompiledBinding BeyondMainText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      FontSize="11"
                      FontWeight="ExtraBold"
                      Margin="3,0,0,0"
                      VerticalAlignment="Top"
                      Foreground="{DynamicResource TsundokuSeriesSpecialVolumeColor}"/>
                  <TextBlock
                      Text="{CompiledBinding CountSuffixText}"
                      IsVisible="{CompiledBinding CountSuffixText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      FontSize="12"
                      FontWeight="Bold"
                      Margin="4,0,0,0"
                      Opacity="0.65"
                      Foreground="{DynamicResource TsundokuSeriesCardDescColor}"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- Progress Footer -->
            <Border Grid.Row="1" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource TsundokuSeriesCardDividerColor}" Margin="8,0,8,0" Padding="0,6,0,6">
            <Grid
                ColumnDefinitions="Auto,*,Auto">
              <!-- + over − stacked to the bar's height -->
              <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                <StackPanel.Styles>
                  <Style Selector="Button.vol-step">
                    <Setter Property="Width" Value="24"/>
                    <Setter Property="Height" Value="13"/>
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="0"/>
                  </Style>
                </StackPanel.Styles>
                <Button Classes="vol-step" Theme="{DynamicResource SeriesCardButton}" i:Attached.Icon="fa7-solid fa7-plus" Click="AddVolume" ToolTip.Tip="Add the next volume"/>
                <Button Classes="vol-step" Theme="{DynamicResource SeriesCardButton}" i:Attached.Icon="fa7-solid fa7-minus" Click="SubtractVolume" ToolTip.Tip="Remove the highest volume"/>
              </StackPanel>

              <!-- Volume strip -->
              <Panel Grid.Column="1"
                     Cursor="Hand"
                     Background="Transparent"
                     PointerPressed="OpenVolumesOwned"
                     ToolTip.Tip="Click to mark which volumes you own">
                <controls:VolumeStrip
                    Height="28"
                    OwnedVolumes="{CompiledBinding OwnedVolumes}"
                    SpecialVolumes="{CompiledBinding SpecialVolumes}"
                    ExtraVolumes="{CompiledBinding ExtraVolumes}"
                    MaxVolumeCount="{CompiledBinding MaxVolumeCount}"
                    Track="{DynamicResource TsundokuSeriesProgressBarBGColor}"
                    Fill="{DynamicResource TsundokuSeriesProgressBarColor}"
                    Outline="{DynamicResource TsundokuSeriesProgressBarBorderColor}"
                    SpecialFill="{DynamicResource TsundokuSeriesSpecialVolumeColor}"
                    MissingFill="#E0605A"/>
              </Panel>

              <!-- Edit Button -->
              <Button
                  Grid.Column="2"
                  Theme="{DynamicResource SeriesCardButton}"
                  Margin="8,0,0,0"
                  i:Attached.Icon="fa7-solid fa7-pen"
                  FontSize="14"
                  ToolTip.Tip="Edit Series (Ctrl+E on hovered card, Ctrl+R to refresh)"
                  Click="OpenEditSeriesInfoWindow"/>
            </Grid>
            </Border>
          </Grid>
        </Grid>
        </Panel>
      </Grid>
    </Border>
  </Border>
</UserControl>