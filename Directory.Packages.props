    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.2.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.9" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="7.1.0" />
  </ItemGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="CsvHelper" Version="34.1.0" />
    <PackageVersion Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <PackageVersion Include="GraphQL.Client" Version="6.1.0" />
