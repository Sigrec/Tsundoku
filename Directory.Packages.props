    <PackageVersion Include="TextCopy" Version="6.2.1" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.2.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
