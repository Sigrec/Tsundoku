    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="NLog" Version="6.2.2" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.3.0" />
    <PackageVersion Include="Optris.Icons.Avalonia.FontAwesome7" Version="12.2.1" />
